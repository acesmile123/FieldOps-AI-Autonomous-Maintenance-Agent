# Backend only. Never expose these values to the browser.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_SPARK_MODEL=muse-spark-1.3
META_VOICE_MODEL=muse-voice-transcribe-1.0

# Use true only for deterministic development/rehearsal output.
# UI must visibly label mock mode.
DEMO_MOCK_MODE=true

# Application
DATABASE_URL=sqlite:///./fieldops.db
BACKEND_CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./.uploads
MAX_IMAGE_MB=10
MAX_AUDIO_MB=20
REQUEST_TIMEOUT_SECONDS=60

# Frontend public setting (set in frontend/.env.local if needed):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
